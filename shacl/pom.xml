<?xml version="1.0" encoding="UTF-8"?>
<!-- Fetches Apache Jena's command-line tools (SHACL validation, riot) from Maven Central into
     .cache/jena/<hash of this file> (gitignored; `make fetch`) or, in the build image, /opt/jena/lib.
     Not a build. Used by scripts/shacl.py for the SHACL checks of the check and publish stages:
     the same results as pySHACL, ~50 times faster and in a fraction of the memory (planning review
     2026-11-25, section 6). Jena 5.x, not 6: Jena 6 needs Java 21, the image has Java 17 (Ontop). Kept apart from
     mapping/pom.xml, so that Jena's jars never meet Ontop's on one classpath. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>net.lod-am</groupId>
  <artifactId>pipeline-jena</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <dependencies>
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-cmds</artifactId>
      <version>5.6.0</version>
    </dependency>
    <!-- Jena logs through SLF4J; without a provider it prints three warnings per run (same version as Jena's slf4j-api) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <version>2.0.20</version>
    </dependency>
  </dependencies>
</project>
