# Copy to .env (chmod 600) and fill in. Never commit .env.
POSTGRES_DB=change-me
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
# DB_BIND=127.0.0.1            # 0.0.0.0 only if a LAN client must reach port 5432 directly
# PGADMIN_BIND=0.0.0.0
PGADMIN_DEFAULT_EMAIL=admin@example.invalid
PGADMIN_DEFAULT_PASSWORD=change-me
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAYS=14
WATCHTOWER_NOTIFICATION_EMAIL_FROM=watchtower@example.invalid
WATCHTOWER_NOTIFICATION_EMAIL_TO=owner@example.invalid
WATCHTOWER_NOTIFICATION_EMAIL_SERVER=smtp.example.invalid
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT=587
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER=change-me
WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=change-me
