    given-names: Fabian
    orcid: "https://orcid.org/0000-0003-3223-2079"
    website: "https://lod-am.net/about/"
repository-code: "https://github.com/LOD-AM/pipeline"
url: "https://lod-am.net/"
license: MIT
keywords:
  - Linked Open Data
  - archaeometallurgy
  - R2RML
  - Ontop
  - data pipeline
