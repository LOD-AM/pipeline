# Connection of the snapshot stage to the live research database (libpq variables).
# Copy to .env on the server (gitignored) and fill in; never commit real values.
# The role must be read-only (README.md, "Read-only role").
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=change-me
PGUSER=lodam_pipeline
PGPASSWORD=change-me

# Optional (planning#7): hand each new release to the triplestore (deploy/run.sh). LODAM_PUBLISH_DIR
# receives a world-readable copy of out/release/ (released data only), which the triplestore fetches
# with rsync over SSH (triplestore README "Releases": /srv/lodam/release). The webhook signals it; the
# token comes from the triplestore's deploy/install.sh, is a shared secret and never reaches the container.
LODAM_PUBLISH_DIR=
LODAM_RELEASE_WEBHOOK=
LODAM_RELEASE_WEBHOOK_TOKEN=
